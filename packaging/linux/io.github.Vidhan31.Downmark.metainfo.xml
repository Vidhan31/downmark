<?xml version="1.0" encoding="UTF-8"?>
<component type="desktop-application">
  <id>io.github.Vidhan31.Downmark</id>
  <metadata_license>CC0-1.0</metadata_license>
  <project_license>Apache-2.0</project_license>
  <name>Downmark</name>
  <summary>Write and preview Markdown</summary>
  <developer id="io.github.vidhan31">
    <name>Downmark Developers</name>
  </developer>
  <description>
    <p>
      Downmark is a fast, native Markdown editor and previewer. A
      syntax-highlighted editor sits next to a live GitHub-flavored preview,
      and the two panes scroll together.
    </p>
    <ul>
      <li>Tables, task lists, fenced code with highlighting, front matter and images</li>
      <li>GitHub alerts and LaTeX math, typeset offline</li>
      <li>Formatting commands</li>
      <li>Light and dark themes</li>
    </ul>
  </description>
  <launchable type="desktop-id">io.github.Vidhan31.Downmark.desktop</launchable>
  <provides>
    <binary>downmark</binary>
    <mediatype>text/markdown</mediatype>
  </provides>
  <url type="homepage">https://github.com/Vidhan31/downmark</url>
  <url type="vcs-browser">https://github.com/Vidhan31/downmark</url>
  <url type="bugtracker">https://github.com/Vidhan31/downmark/issues</url>
  <categories>
    <category>Utility</category>
    <category>TextEditor</category>
  </categories>
  <branding>
    <color type="primary" scheme_preference="light">#24292e</color>
    <color type="primary" scheme_preference="dark">#161b22</color>
  </branding>
  <recommends>
    <control>keyboard</control>
    <control>pointing</control>
  </recommends>
  <requires>
    <display_length compare="ge">768</display_length>
  </requires>
  <screenshots>
    <screenshot type="default">
      <caption>Editor and preview side by side</caption>
      <image>https://raw.githubusercontent.com/Vidhan31/downmark/v0.1.1/docs/screenshot-light.png</image>
    </screenshot>
    <screenshot>
      <caption>GitHub alerts and math</caption>
      <image>https://raw.githubusercontent.com/Vidhan31/downmark/v0.1.1/docs/screenshot-alerts-math.png</image>
    </screenshot>
  </screenshots>
  <content_rating type="oars-1.1"/>
  <releases>
    <release version="1.0.0" date="2026-10-28"/>
  </releases>
</component>
