root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space

# Rust source files
[*.rs]
indent_size = 4

# Configuration and data files
[*.{json,yaml,yml,toml}]
indent_size = 2

# Shell scripts
[*.sh]
indent_size = 4

# Markdown documentation
[*.md]
indent_size = 2
trim_trailing_whitespace = false
